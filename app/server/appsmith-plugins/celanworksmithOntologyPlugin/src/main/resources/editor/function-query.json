{
  "controlType": "SECTION_V2",
  "identifier": "ONTOLOGY_FUNCTION_QUERY",
  "conditionals": {
    "show": "{{actionConfiguration.formData.operation.data === 'FUNCTION_QUERY'}}"
  },
  "children": [
    {
      "controlType": "SINGLE_COLUMN_ZONE",
      "identifier": "ONTOLOGY_FUNCTION_QUERY_ZONE",
      "children": [
        {
          "label": "Query mode",
          "configProperty": "actionConfiguration.formData.queryMode.data",
          "controlType": "DROP_DOWN",
          "initialValue": "BUILDER",
          "options": [
            { "label": "Builder", "value": "BUILDER" },
            { "label": "Advanced JSON", "value": "ADVANCED" }
          ]
        },
        {
          "label": "Object type",
          "configProperty": "actionConfiguration.formData.objectTypeId.data",
          "controlType": "DROP_DOWN",
          "isRequired": true,
          "placeholderText": "Select an object type",
          "fetchOptionsConditionally": true,
          "conditionals": {
            "fetchDynamicValues": {
              "condition": "{{true}}",
              "config": {
                "params": {
                  "requestType": "ONTOLOGY_OBJECT_TYPES",
                  "displayType": "DROP_DOWN"
                }
              }
            }
          }
        },
        {
          "label": "Function",
          "configProperty": "actionConfiguration.formData.functionId.data",
          "controlType": "DROP_DOWN",
          "isRequired": true,
          "placeholderText": "Select a function",
          "fetchOptionsConditionally": true,
          "conditionals": {
            "enable": "{{!!actionConfiguration.formData.objectTypeId.data}}",
            "fetchDynamicValues": {
              "condition": "{{!!actionConfiguration.formData.objectTypeId.data}}",
              "config": {
                "params": {
                  "requestType": "ONTOLOGY_FUNCTIONS",
                  "displayType": "DROP_DOWN",
                  "parameters": {
                    "objectTypeId": "{{actionConfiguration.formData.objectTypeId.data}}"
                  }
                }
              }
            }
          }
        },
        {
          "label": "Target",
          "configProperty": "actionConfiguration.formData.target.data",
          "controlType": "ONTOLOGY_CAPABILITY_TARGET",
          "maxItems": 1000,
          "isRequired": true,
          "conditionals": {
            "show": "{{actionConfiguration.formData.queryMode.data === 'BUILDER'}}"
          }
        },
        {
          "label": "Parameters",
          "propertyName": "ONTOLOGY_FUNCTION_PARAMETERS",
          "configProperty": "actionConfiguration.formData.parameters.data",
          "controlType": "FUNCTION_PARAMETERS",
          "evaluationSubstitutionType": "TEMPLATE",
          "fetchOptionsConditionally": true,
          "conditionals": {
            "show": "{{actionConfiguration.formData.queryMode.data === 'BUILDER'}}",
            "enable": "{{!!actionConfiguration.formData.objectTypeId.data && !!actionConfiguration.formData.functionId.data}}",
            "fetchDynamicValues": {
              "condition": "{{actionConfiguration.formData.queryMode.data === 'BUILDER' && !!actionConfiguration.formData.objectTypeId.data && !!actionConfiguration.formData.functionId.data}}",
              "config": {
                "params": {
                  "requestType": "ONTOLOGY_FUNCTION_PARAMETERS",
                  "displayType": "DROP_DOWN",
                  "parameters": {
                    "objectTypeId": "{{actionConfiguration.formData.objectTypeId.data}}",
                    "functionId": "{{actionConfiguration.formData.functionId.data}}"
                  }
                }
              }
            }
          }
        },
        {
          "label": "Advanced JSON definition",
          "configProperty": "actionConfiguration.formData.definition.data",
          "controlType": "QUERY_DYNAMIC_INPUT_TEXT",
          "inputType": "JSON",
          "disabled": "{{actionConfiguration.formData.queryMode.data !== 'ADVANCED'}}",
          "hidden": {
            "path": "actionConfiguration.formData.queryMode.data",
            "comparison": "EQUALS",
            "value": "BUILDER"
          },
          "isRequired": true,
          "evaluationSubstitutionType": "TEMPLATE",
          "conditionals": {
            "show": "{{actionConfiguration.formData.queryMode.data === 'ADVANCED'}}"
          },
          "placeholderText": "{\"target\":{\"source\":\"OBJECT_SET\",\"objectIds\":[\"PO001\",\"PO002\"]},\"parameters\":{}}"
        }
      ]
    }
  ]
}
